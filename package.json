{
  "name": "fdo",
  "productName": "FDO (FlexDevOPs)",
  "desktopName": "me.alexvwan.fdo",
  "version": "1.0.0-rc.3",
  "description": "FDO (Flex DevOps) is a modular, plugin-driven DevOps platform built with ElectronJS and React. It empowers developers and SREs to extend core functionality using secure, versioned plugins, offering tools for automation, deployment, monitoring, and workflow customization — all from a unified desktop environment.",
  "main": "dist/main/index.js",
  "sideEffects": [
    "./src/utils/system/installStdioErrorHandlers.js",
    "*.css",
    "*.scss",
    "src/renderer.js",
    "src/main.jsx",
    "src/renderer_plugin_host.js"
  ],
  "scripts": {
    "dev": "npm run clean:dist && concurrently \"npm run build:main:dev\" \"npm run build:preload:dev\" \"npm run build:renderer:dev\" \"wait-on dist/main/index.js dist/main/preload.js dist/renderer/index.html && electron .\"",
    "start": "npm run dev",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "webpack --config webpack.main.config.js --mode=production",
    "build:main:dev": "webpack --config webpack.main.config.js --mode=development --watch",
    "build:preload": "webpack --config webpack.preload.config.js --mode=production",
    "build:preload:dev": "webpack --config webpack.preload.config.js --mode=development --watch",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode=production",
    "build:renderer:dev": "webpack --config webpack.renderer.config.js --mode=development --watch",
    "build:analyze": "npm run build && source-map-explorer 'dist/renderer/*.js' 'dist/main/*.js' --html bundle-report.html --only-mapped",
    "package": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --publish=never",
    "dist:mac": "npm run build && electron-builder --mac --publish=never",
    "dist:linux": "npm run build && electron-builder --linux --publish=never",
    "dist:win": "npm run build && electron-builder --win --publish=never",
    "publish": "node scripts/release/publish.cjs",
    "release:check": "node scripts/release/validate.cjs",
    "lint": "echo \"No linting configured\"",
    "test:playwright": "playwright test",
    "pretest": "npm run build",
    "test": "node scripts/run-jest.cjs",
    "test:unit": "node scripts/run-jest.cjs",
    "test:e2e": "playwright test",
    "test:e2e:sdk-examples": "playwright test tests/e2e/sdk-examples-smoke.spec.js --workers=1",
    "test:e2e:fixtures:matrix": "playwright test tests/e2e/sdk-fixture-runtime-matrix.spec.js --workers=1 --retries=0",
    "test:e2e:sdk-examples:behavior": "playwright test tests/e2e/sdk-examples-behavior.spec.js --workers=1",
    "test:e2e:sdk-examples:coverage": "playwright test tests/e2e/sdk-examples-line-coverage.spec.js --workers=1",
    "test:e2e:sdk-examples:per-plugin": "playwright test tests/e2e/sdk-examples-per-plugin.spec.js --workers=1",
    "test:e2e:full": "playwright test --grep-invert \"quota exceeded surfaces danger toast\"",
    "test:e2e:smoke": "npm run test:e2e:smoke:parallel && npm run test:e2e:smoke:isolated",
    "test:e2e:smoke:parallel": "playwright test tests/e2e/main-window.spec.js tests/e2e/editor-window.spec.js tests/e2e/ai-coding-agent.spec.js --grep-invert \"quota exceeded surfaces danger toast\" --workers=2",
    "test:e2e:smoke:isolated": "playwright test tests/e2e/snapshots.e2e.spec.js tests/e2e/plugin-stability.spec.js --grep-invert \"quota exceeded surfaces danger toast\" --workers=1 --retries=1",
    "test:e2e:faults": "playwright test --grep \"quota exceeded surfaces danger toast\"",
    "test:editor:unit": "node scripts/run-jest.cjs tests/unit/editor-snapshot-state.test.js tests/components/editor/EditorPage.test.jsx tests/components/editor/EditorChromeStatus.test.jsx tests/components/snapshots/SnapshotToolbarActions.test.jsx tests/components/snapshots/SnapshotPanel.test.jsx --runInBand",
    "test:editor:e2e": "playwright test tests/e2e/snapshots.e2e.spec.js",
    "test:router": "node scripts/run-jest.cjs tests/router-regression.test.js --runInBand",
    "test:fdo-benchmark": "node scripts/run-jest.cjs tests/fdo-retrieval-benchmark.test.js --runInBand",
    "test:ai:live": "node scripts/test-editor-live-ai.cjs",
    "test:ai:transport": "node scripts/diagnose-electron-transport.cjs",
    "test:ai:probe": "node scripts/diagnose-ai-provider.cjs",
    "test:ai:reliability": "node scripts/test-ai-reliability.cjs",
    "test:ai:safety": "node scripts/run-jest.cjs tests/unit/cursor-provider.test.js tests/unit/coding-workspace-generation.test.js tests/unit/workspace-type-import-repair.test.js tests/unit/generated-module-exports.test.js tests/unit/workspace-css-composition.test.js tests/unit/generated-workspace-imports.test.js tests/unit/ai-billing.test.js tests/components/AiUsagePopover.test.jsx tests/unit/ai-model-capabilities.test.js tests/unit/gemini-provider.test.js tests/unit/anthropic-provider-policy.test.js tests/unit/ai-provider-client.test.js tests/unit/native-provider-contracts.test.js tests/unit/openrouter-provider.test.js tests/unit/opencode-provider.test.js tests/unit/cloudflare-structured-output.test.js tests/unit/provider-structured-output.test.js tests/unit/coding-llm-request.test.js tests/unit/cloudflare-provider.test.js tests/components/editor/AiCodingAgentPanel.test.jsx tests/components/AIAssistantsPanel.ollama.test.jsx tests/unit/ollama-provider.test.js tests/unit/coding-ollama-stream.test.js tests/unit/coding-first-content-deadline.test.js tests/unit/coding-llm-stream.test.js tests/unit/ai-coding-output-recovery.test.js tests/unit/ai-coding-transient-recovery.test.js tests/unit/ai-coding-agent-plugin-scope.test.js tests/unit/ai-coding-agent-issue-scope.test.js tests/unit/ai-coding-agent-timeouts.test.js tests/unit/live-ai-lifecycle.test.js tests/unit/live-ai-transport-log.test.js tests/unit/stdio-errors.test.js tests/unit/ipc-reply-target.test.js tests/unit/live-ai-reliability.test.js tests/unit/live-ai-test-budget.test.js --runInBand",
    "test:ai:isolation": "node scripts/check-plugin-assistant-isolation.cjs",
    "test:ai:live:codex": "FDO_E2E_LIVE_AI=1 node scripts/evaluate-plugin-assistant.cjs",
    "test:ai:hardening": "node scripts/run-jest.cjs tests/unit/workspace-sdk-dom-repair.test.js tests/unit/generated-workspace-calls.test.js tests/unit/generated-workspace-options.test.js tests/unit/ai-workspace-candidate.test.js tests/unit/ai-workspace-apply.test.js tests/unit/ai-release-gate.test.js tests/components/editor/AiCodingAgentPanel.test.jsx tests/components/editor/utils/VirtualFS.test.js --runInBand",
    "test:ai:release": "node scripts/check-ai-release.cjs",
    "test:e2e:ci": "playwright test --config=playwright.ci.config.js",
    "test:ci": "node scripts/run-jest.cjs --ci --silent",
    "check:dependencies": "node scripts/check-dependencies.cjs",
    "test:handles": "node scripts/run-jest.cjs --detectOpenHandles --runInBand",
    "website:dev": "node scripts/website/site.cjs serve",
    "website:check": "node scripts/website/site.cjs check"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-dynamic-import": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@electron/asar": "^4.3.1",
    "@jest/globals": "30.5.2",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@vercel/webpack-asset-relocator-loader": "^1.11.0",
    "babel-loader": "^10.1.1",
    "babel-preset-current-node-syntax": "file:packages/babel-current-node-syntax",
    "buffer": "^6.0.3",
    "concurrently": "^10.0.6",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "electron": "^44.7.2",
    "electron-builder": "26.15.3",
    "html-webpack-plugin": "^5.6.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.2.0",
    "node-loader": "^2.1.0",
    "path-browserify": "^1.0.1",
    "playwright": "1.64.1",
    "process": "^0.11.10",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "source-map-explorer": "^2.5.3",
    "style-loader": "^4.0.0",
    "wait-on": "^9.5.1",
    "webpack": "^5.111.1",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3"
  },
  "keywords": [
    "devops",
    "sre",
    "automation",
    "monitoring",
    "plugin",
    "modular",
    "electron",
    "electronjs",
    "react",
    "desktop-app",
    "flexible-devops",
    "workflow",
    "infrastructure",
    "plugin-system",
    "secure-plugins",
    "customizable",
    "tooling",
    "kubernetes",
    "ci-cd",
    "cloud-native"
  ],
  "author": {
    "name": "Oleksandr Nykytenko (AleXvWaN)",
    "email": "me@alexvwan.me"
  },
  "license": "MIT",
  "dependencies": {
    "@anikitenko/fdo-sdk": "^1.8.3",
    "@anthropic-ai/sdk": "0.134.0",
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.7",
    "@babel/standalone": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.6",
    "@blueprintjs/core": "^6.21.0",
    "@blueprintjs/datetime": "^6.3.0",
    "@blueprintjs/icons": "^6.14.1",
    "@blueprintjs/select": "^6.4.0",
    "@cursor/sdk": "1.0.37",
    "@dnd-kit/core": "^6.3.1",
    "@expo/sudo-prompt": "^9.3.2",
    "@google/genai": "2.30.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@monaco-editor/react": "^4.7.0",
    "@openai/codex": "^0.162.1",
    "@peculiar/x509": "^2.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "archiver": "^8.0.0",
    "classnames": "^2.5.1",
    "cloudflare": "7.3.0",
    "commander": "^15.0.0",
    "date-fns": "^4.4.0",
    "dugite": "3.2.3",
    "electron-localshortcut": "^3.2.1",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "emojibase-data": "^17.0.0",
    "esbuild": "^0.28.2",
    "file-type": "^22.2.0",
    "github-markdown-css": "^5.9.0",
    "html-tags": "^5.1.0",
    "ignore": "^7.0.12",
    "jimp": "^1.6.1",
    "js-yaml": "^5.4.3",
    "lodash": "^4.17.21",
    "lookpath": "^1.2.3",
    "lz-string": "^1.5.0",
    "markdown-to-jsx": "^9.10.3",
    "mime": "^4.1.1",
    "mime-types": "^3.0.1",
    "monaco-editor": "^0.57.0",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "node-domexception": "file:packages/node-domexception",
    "normalize.css": "^8.0.1",
    "ollama": "0.6.4",
    "openai": "7.34.0",
    "parse5": "8.0.1",
    "pify": "^6.1.0",
    "postcss": "8.5.30",
    "postcss-safe-parser": "^7.1.0",
    "prettier": "^3.9.10",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-contexify": "^6.0.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.4",
    "react-split-grid": "^1.0.4",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "split-grid": "^1.0.11",
    "ssh2": "^1.17.0",
    "stylis": "^4.4.0",
    "typescript": "7.0.2",
    "unique-names-generator": "^4.7.1",
    "uuid": "^14.0.3",
    "vscode-icons-js": "^11.6.1"
  },
  "overrides": {
    "glob": "^13.0.6",
    "rimraf": "^6.0.0",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.0",
    "@npmcli/move-file": "npm:@npmcli/fs@^3.1.0",
    "npmlog": "npm:proc-log@^4.0.0",
    "are-we-there-yet": "npm:proc-log@^4.0.0",
    "gauge": "npm:proc-log@^4.0.0",
    "boolean": "npm:yn@^5.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    },
    "jest-environment-jsdom": {
      "jsdom": "^27.4.0"
    },
    "node-domexception": "$node-domexception",
    "@electron/get": "^5.1.0",
    "babel-preset-current-node-syntax": "$babel-preset-current-node-syntax",
    "react-popper": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "dompurify": "^3.4.17"
  },
  "build": {
    "appId": "me.alexvwan.fdo",
    "productName": "FDO (FlexDevOPs)",
    "executableName": "FDO",
    "asar": {
      "smartUnpack": false
    },
    "asarUnpack": [
      "dist/main/node_modules/typescript/**/*",
      "dist/main/node_modules/@types/node/**/*",
      "dist/main/node_modules/undici-types/**/*",
      "dist/main/gitSshHelper.cjs",
      "dist/main/node_modules/@anikitenko/fdo-sdk/**/*",
      "dist/main/node_modules/esbuild/**/*",
      "dist/main/node_modules/@esbuild/**/*",
      "dist/main/node_modules/@cursor/**/*",
      "dist/main/node_modules/@bufbuild/**/*",
      "dist/main/node_modules/@connectrpc/**/*",
      "dist/main/node_modules/@statsig/**/*",
      "dist/main/node_modules/@typescript/**/*"
    ],
    "compression": "maximum",
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/**/*",
      "!dist/main/git/**/*",
      "!dist/main/git-*/**/*",
      "!dist/**/test/**/*",
      "!dist/**/*.test.*",
      "!dist/**/*.spec.*",
      "!dist/**/__tests__/**/*",
      "!dist/**/*.md",
      "!dist/main/node_modules/@google/gemini-cli/**/*",
      "!dist/main/node_modules/@google/gemini-cli-core/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/main/git-${arch}",
        "to": "git"
      },
      {
        "from": "dist/main/node_modules/typescript",
        "to": "app.asar.unpacked/dist/main/node_modules/typescript"
      },
      {
        "from": "dist/main/node_modules/@typescript",
        "to": "app.asar.unpacked/dist/main/node_modules/@typescript"
      },
      {
        "from": "dist/main/node_modules/@types/node",
        "to": "app.asar.unpacked/dist/main/node_modules/@types/node"
      },
      {
        "from": "dist/main/node_modules/undici-types",
        "to": "app.asar.unpacked/dist/main/node_modules/undici-types"
      },
      {
        "from": "dist/main/node_modules/esbuild",
        "to": "app.asar.unpacked/dist/main/node_modules/esbuild"
      },
      {
        "from": "dist/main/node_modules/@esbuild",
        "to": "app.asar.unpacked/dist/main/node_modules/@esbuild"
      },
      {
        "from": "dist/main/node_modules/@anikitenko",
        "to": "app.asar.unpacked/dist/main/node_modules/@anikitenko"
      },
      {
        "from": "dist/main/node_modules/@openai",
        "to": "app.asar.unpacked/dist/main/node_modules/@openai"
      }
    ],
    "protocols": [
      {
        "name": "FDO Opener",
        "schemes": [
          "fdo-fiddle"
        ]
      }
    ],
    "mac": {
      "icon": "src/assets/icons/fdo_icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "background": "src/assets/preview-dmg-600x400.png",
      "format": "ULFO",
      "iconSize": 100,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "src/assets/icons/fdo_icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "src/assets/icons/fdo_icon.png",
      "category": "Utility",
      "executableName": "fdo",
      "syncDesktopName": true,
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "maintainer": "AleXvWaN",
      "category": "Utility"
    },
    "rpm": {
      "vendor": "AleXvWaN",
      "category": "Utility"
    },
    "afterPack": "./scripts/fix-bundled-binary-permissions.js",
    "beforePack": "./scripts/check-bundled-host-runtime.cjs"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "allowScripts": {
    "dugite@3.2.3": true,
    "ssh2@1.17.0": false,
    "cpu-features@0.0.10": false,
    "@google/genai@2.30.0": true,
    "@parcel/watcher@2.6.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true
  }
}
