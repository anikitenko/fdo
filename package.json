{
  "name": "fdo",
  "productName": "FDO (FlexDevOPs)",
  "version": "1.0.0",
  "description": "FDO (Flex DevOps) is a modular, plugin-driven DevOps platform built with ElectronJS and React. It empowers developers and SREs to extend core functionality using secure, versioned plugins, offering tools for automation, deployment, monitoring, and workflow customization — all from a unified desktop environment.",
  "main": "dist/main/index.js",
  "sideEffects": [
    "./src/utils/installStdioErrorHandlers.js",
    "*.css",
    "*.scss",
    "src/renderer.js",
    "src/main.jsx",
    "src/renderer_plugin_host.js"
  ],
  "scripts": {
    "dev": "npm run clean:dist && concurrently \"npm run build:main:dev\" \"npm run build:preload:dev\" \"npm run build:renderer:dev\" \"wait-on dist/main/index.js dist/main/preload.js dist/renderer/index.html && electron .\"",
    "start": "npm run dev",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "webpack --config webpack.main.config.js --mode=production",
    "build:main:dev": "webpack --config webpack.main.config.js --mode=development --watch",
    "build:preload": "webpack --config webpack.preload.config.js --mode=production",
    "build:preload:dev": "webpack --config webpack.preload.config.js --mode=development --watch",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode=production",
    "build:renderer:dev": "webpack --config webpack.renderer.config.js --mode=development --watch",
    "build:analyze": "npm run build && source-map-explorer 'dist/renderer/*.js' 'dist/main/*.js' --html bundle-report.html --only-mapped",
    "package": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --publish=never",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "publish": "npm run build && electron-builder --publish=always",
    "lint": "echo \"No linting configured\"",
    "test:playwright": "playwright test",
    "pretest": "npm run build",
    "test": "jest --detectOpenHandles",
    "test:unit": "jest --detectOpenHandles",
    "test:e2e": "playwright test",
    "test:e2e:sdk-examples": "playwright test tests/e2e/sdk-examples-smoke.spec.js --workers=1",
    "test:e2e:fixtures:matrix": "playwright test tests/e2e/sdk-fixture-runtime-matrix.spec.js --workers=1 --retries=0",
    "test:e2e:sdk-examples:behavior": "playwright test tests/e2e/sdk-examples-behavior.spec.js --workers=1",
    "test:e2e:sdk-examples:coverage": "playwright test tests/e2e/sdk-examples-line-coverage.spec.js --workers=1",
    "test:e2e:sdk-examples:per-plugin": "playwright test tests/e2e/sdk-examples-per-plugin.spec.js --workers=1",
    "test:e2e:full": "playwright test --grep-invert \"quota exceeded surfaces danger toast\"",
    "test:e2e:smoke": "npm run test:e2e:smoke:parallel && npm run test:e2e:smoke:isolated",
    "test:e2e:smoke:parallel": "playwright test tests/e2e/main-window.spec.js tests/e2e/editor-window.spec.js tests/e2e/ai-coding-agent.spec.js --grep-invert \"quota exceeded surfaces danger toast\" --workers=2",
    "test:e2e:smoke:isolated": "playwright test tests/e2e/snapshots.e2e.spec.js tests/e2e/plugin-stability.spec.js --grep-invert \"quota exceeded surfaces danger toast\" --workers=1 --retries=1",
    "test:e2e:faults": "playwright test --grep \"quota exceeded surfaces danger toast\"",
    "test:editor:unit": "jest tests/unit/editor-snapshot-state.test.js tests/components/editor/EditorPage.test.jsx tests/components/editor/EditorChromeStatus.test.jsx tests/components/snapshots/SnapshotToolbarActions.test.jsx tests/components/snapshots/SnapshotPanel.test.jsx --runInBand",
    "test:editor:e2e": "playwright test tests/e2e/snapshots.e2e.spec.js",
    "test:router": "jest tests/router-regression.test.js --runInBand",
    "test:fdo-benchmark": "jest tests/fdo-retrieval-benchmark.test.js --runInBand",
    "test:ai:live": "node scripts/test-editor-live-ai.cjs",
    "test:ai:transport": "node scripts/diagnose-electron-transport.cjs",
    "test:ai:probe": "node scripts/diagnose-ai-provider.cjs",
    "test:ai:reliability": "node scripts/test-ai-reliability.cjs",
    "test:ai:safety": "jest tests/unit/coding-workspace-generation.test.js tests/unit/ai-billing.test.js tests/components/AiUsagePopover.test.jsx tests/unit/ai-model-capabilities.test.js tests/unit/gemini-provider.test.js tests/unit/anthropic-provider-policy.test.js tests/unit/ai-provider-client.test.js tests/unit/native-provider-contracts.test.js tests/unit/cloudflare-structured-output.test.js tests/unit/provider-structured-output.test.js tests/unit/coding-llm-request.test.js tests/unit/cloudflare-provider.test.js tests/components/editor/AiCodingAgentPanel.test.jsx tests/components/AIAssistantsPanel.ollama.test.jsx tests/unit/ollama-provider.test.js tests/unit/coding-ollama-stream.test.js tests/unit/coding-first-content-deadline.test.js tests/unit/coding-llm-stream.test.js tests/unit/ai-coding-output-recovery.test.js tests/unit/ai-coding-transient-recovery.test.js tests/unit/ai-coding-agent-plugin-scope.test.js tests/unit/ai-coding-agent-issue-scope.test.js tests/unit/ai-coding-agent-timeouts.test.js tests/unit/live-ai-lifecycle.test.js tests/unit/live-ai-transport-log.test.js tests/unit/stdio-errors.test.js tests/unit/ipc-reply-target.test.js tests/unit/live-ai-reliability.test.js tests/unit/live-ai-test-budget.test.js --runInBand",
    "test:ai:isolation": "node scripts/check-plugin-assistant-isolation.cjs",
    "test:ai:live:codex": "FDO_E2E_LIVE_AI=1 node scripts/evaluate-plugin-assistant.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@electron/asar": "^4.3.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^14.2.1",
    "@types/node": "^22.18.13",
    "@vercel/webpack-asset-relocator-loader": "^1.10.0",
    "babel-loader": "^10.0.0",
    "buffer": "^6.0.3",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "electron": "^44.4.1",
    "electron-builder": "^26.8.1",
    "electron-squirrel-startup": "^1.0.1",
    "html-webpack-plugin": "^5.6.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "node-loader": "^2.1.0",
    "path-browserify": "^1.0.1",
    "playwright": "1.63.0",
    "process": "^0.11.10",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.6",
    "source-map-explorer": "^2.5.3",
    "style-loader": "^4.0.0",
    "wait-on": "^9.0.1",
    "webpack": "^5.102.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1"
  },
  "keywords": [
    "devops",
    "sre",
    "automation",
    "monitoring",
    "plugin",
    "modular",
    "electron",
    "electronjs",
    "react",
    "desktop-app",
    "flexible-devops",
    "workflow",
    "infrastructure",
    "plugin-system",
    "secure-plugins",
    "customizable",
    "tooling",
    "kubernetes",
    "ci-cd",
    "cloud-native"
  ],
  "author": {
    "name": "Oleksandr Nykytenko (AleXvWaN)",
    "email": "me@alexvwan.me"
  },
  "license": "MIT",
  "dependencies": {
    "@anikitenko/bp5-rjsf-theme": "^1.0.11",
    "@anikitenko/fdo-sdk": "^1.5.1",
    "@anthropic-ai/sdk": "0.127.0",
    "@babel/standalone": "^7.29.2",
    "@blueprintjs/core": "^6.11.3",
    "@blueprintjs/icons": "^6.8.0",
    "@blueprintjs/select": "^6.1.8",
    "@dnd-kit/core": "^6.3.1",
    "@expo/sudo-prompt": "^9.3.2",
    "@google/gemini-cli": "^0.60.0",
    "@google/genai": "2.23.0",
    "@monaco-editor/react": "^4.7.0",
    "@openai/codex": "^0.154.0",
    "@rjsf/core": "^5.24.13",
    "@rjsf/utils": "^5.24.13",
    "@rjsf/validator-ajv8": "^5.24.13",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@xyflow/react": "^12.9.1",
    "archiver": "^7.0.1",
    "classnames": "^2.5.1",
    "cloudflare": "7.1.0",
    "commander": "^14.0.2",
    "date-fns": "^4.1.0",
    "electron-localshortcut": "^3.2.1",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "emojibase-data": "^17.0.0",
    "esbuild": "^0.28.2",
    "file-type": "^21.0.0",
    "github-markdown-css": "^5.8.1",
    "html-tags": "^5.1.0",
    "ignore": "^7.0.5",
    "jimp": "^1.6.1",
    "lodash": "^4.17.21",
    "lookpath": "^1.2.3",
    "lz-string": "^1.5.0",
    "markdown-to-jsx": "^8.0.0",
    "mdn-data": "^2.24.0",
    "mime": "^4.1.0",
    "mime-types": "^3.0.1",
    "monaco-editor": "^0.53.0",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "node-forge": "^1.3.1",
    "normalize.css": "^8.0.1",
    "ollama": "0.6.3",
    "openai": "7.20.0",
    "pify": "^6.1.0",
    "postcss": "8.5.23",
    "postcss-safe-parser": "^7.0.1",
    "prettier": "^3.6.2",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-colorful": "^5.6.1",
    "react-contexify": "^6.0.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.4",
    "react-split-grid": "^1.0.4",
    "recharts": "^3.3.0",
    "split-grid": "^1.0.11",
    "stylis": "^4.3.6",
    "tributejs": "^5.1.3",
    "unique-names-generator": "^4.7.1",
    "uuid": "^11.1.0",
    "vscode-icons-js": "^11.6.1"
  },
  "overrides": {
    "glob": "^11.0.0",
    "rimraf": "^6.0.0",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.0",
    "@npmcli/move-file": "npm:@npmcli/fs@^3.1.0",
    "npmlog": "npm:proc-log@^4.0.0",
    "are-we-there-yet": "npm:proc-log@^4.0.0",
    "gauge": "npm:proc-log@^4.0.0",
    "boolean": "npm:yn@^5.0.0"
  },
  "build": {
    "appId": "me.alexvwan.fdo",
    "productName": "FDO (FlexDevOPs)",
    "asar": {
      "smartUnpack": false
    },
    "compression": "maximum",
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/**/*",
      "!dist/main/node_modules/@esbuild/**/*",
      "!dist/main/node_modules/esbuild/**/*",
      "!dist/**/test/**/*",
      "!dist/**/*.test.*",
      "!dist/**/*.spec.*",
      "!dist/**/__tests__/**/*",
      "!dist/**/*.md"
    ],
    "extraResources": [
      {
        "from": "dist/main/node_modules/esbuild",
        "to": "app.asar.unpacked/dist/main/node_modules/esbuild"
      },
      {
        "from": "dist/main/node_modules/@esbuild",
        "to": "app.asar.unpacked/dist/main/node_modules/@esbuild"
      },
      {
        "from": "dist/main/node_modules/@anikitenko",
        "to": "app.asar.unpacked/dist/main/node_modules/@anikitenko"
      },
      {
        "from": "dist/main/node_modules/@openai",
        "to": "app.asar.unpacked/dist/main/node_modules/@openai"
      },
      {
        "from": "dist/main/node_modules/@google",
        "to": "app.asar.unpacked/dist/main/node_modules/@google"
      }
    ],
    "protocols": [
      {
        "name": "FDO Opener",
        "schemes": [
          "fdo-fiddle"
        ]
      }
    ],
    "mac": {
      "icon": "src/assets/icons/fdo_icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "background": "src/assets/preview-dmg-600x400.png",
      "format": "ULFO",
      "iconSize": 100,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "src/assets/icons/fdo_icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "src/assets/icons/fdo_icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "maintainer": "AleXvWaN",
      "category": "Utility"
    },
    "rpm": {
      "vendor": "AleXvWaN",
      "category": "Utility"
    },
    "afterPack": "./scripts/fix-bundled-binary-permissions.js"
  }
}
